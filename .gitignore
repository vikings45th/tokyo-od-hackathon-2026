# 秘密情報 — 絶対にコミットしない
.env
.env.*
!.env.example
*.pem
*.key
.dev.vars

# 依存関係
node_modules/

# ビルド成果物
dist/
build/
.wrangler/
.output/

# エディタ・OS
.DS_Store
.vscode/
.idea/
*.swp

# Claude Code のローカル設定（.claude/settings.json は共有するのでコミットする）
.claude/settings.local.json

# ログ
*.log
npm-debug.log*

# Python
__pycache__/
*.pyc

# 取得した元データ（data/README.md 参照）
# raw/ 以下はコミット対象にしない。fetch_raw.py / fetch_population.py / fetch_schools.py で取り直す
data/raw/
# 学童クラブ名簿はオープンデータカタログ未掲載＝転載不可。ライセンス確認が済むまで除外
data/processed/gakudou_clubs_*.csv
# data/ 直下に転載不可PDF/CSVを誤って置いた事故が複数回発生した（2026-08-22、d2b600c 他）。
# data/ 直下は README.md・SOURCES.md・sample.json・app/*.json だけを想定しているので、
# 直下（サブディレクトリではない）へのPDF/CSVの取り込みを防ぐ。
/data/*.csv
/data/*.pdf

# 別リポジトリ（startup/.git を持つ）。ここで追跡すると壊れた gitlink になる（docs/17 依頼C）
startup/

# ③の作業用（スクリーンショット等）。コミットしない
/scratch/

# プレゼン資料のレイアウト参考にした他者の資料（戦略コンサルの公開スライド）。
# 🔴 このリポジトリは public。第三者の著作物を再配布しないためコミットしない。
# 手元に置くだけにする。自作の .pptx はコミットする。
ppt資料/*.pdf

# Office が開いている間に作るロックファイル（~$xxx.pptx）。コミットしない
~$*
